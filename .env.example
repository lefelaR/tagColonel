# Local demo credentials. Copy to .env. Never commit .env.
COMPOSE_PROJECT_NAME=fairwayflow

# Generate with: php artisan key:generate --show
APP_KEY=
APP_ENV=local
APP_DEBUG=true

MYSQL_ROOT_PASSWORD=fairwayflow_dev_root
MYSQL_DATABASE=fairwayflow
MYSQL_USER=fairwayflow
MYSQL_PASSWORD=fairwayflow_dev
MYSQL_PORT=3306

# Laravel talks to MySQL by Compose service name (DIP: host is configuration).
DB_HOST=mysql
DB_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISH_PORT=6379
# Leave empty. Laravel and Node must use the same fairwayflow:course:* keys.
REDIS_PREFIX=

# Server-side URL. Resolves only on the Compose network.
LARAVEL_API=http://laravel:8000

LARAVEL_PORT=8000
NODE_PORT=3000
SOCKET_PORT=3001
VUE_PORT=5173

# Browser-facing URLs. The Vue dev server runs in Docker; the browser does not.
VITE_LARAVEL_API=http://localhost:8000
VITE_SOCKET_URL=http://localhost:3001
